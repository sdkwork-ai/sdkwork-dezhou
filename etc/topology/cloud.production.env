SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_CORS_ALLOWED_ORIGINS=https://dezhou.sdkwork.com,https://dezhou.birdcoder.com,https://dezhou.dtupay.com,https://dezhou.noaper.com,https://dezhou.sdkwork.cn,https://dezhou.birdcoder.cn,https://dezhou.dtupay.cn,https://dezhou.noaper.cn,https://dezhou.skubc.com,https://dezhou.skubc.cn,https://dezhou.zowalk.com,https://dezhou.zowalk.cn,https://dezhou.offer86.com,https://dezhou.offer86.cn,https://dezhou.86offer.com,https://dezhou.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DEZHOU_APP_ROOT=.

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DEZHOU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_DEZHOU_ENVIRONMENT=production
SDKWORK_DEZHOU_DEPLOYMENT_PROFILE=cloud
SDKWORK_DEZHOU_PROFILE_ID=cloud.production
