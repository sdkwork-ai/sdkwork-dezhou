# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_dezhou_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DEZHOU_DEPLOYMENT_PROFILE=cloud
SDKWORK_DEZHOU_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DEZHOU_PROFILE_ID=cloud.demo
SDKWORK_DEZHOU_APPLICATION_PUBLIC_HTTP_URL=https://dezhou-demo.sdkwork.com
SDKWORK_DEZHOU_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
