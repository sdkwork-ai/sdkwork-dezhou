# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_dezhou_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_DEZHOU_DEPLOYMENT_PROFILE=cloud
SDKWORK_DEZHOU_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DEZHOU_PROFILE_ID=cloud.demo
SDKWORK_DEZHOU_APPLICATION_PUBLIC_HTTP_URL=https://dezhou-demo.sdkwork.com
SDKWORK_DEZHOU_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DEZHOU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://dezhou-demo.sdkwork.com,http://dezhou-demo.sdkwork.com,https://dezhou-demo.birdcoder.com,http://dezhou-demo.birdcoder.com,https://dezhou-demo.dtupay.com,http://dezhou-demo.dtupay.com,https://dezhou-demo.noaper.com,http://dezhou-demo.noaper.com,https://dezhou-demo.sdkwork.cn,http://dezhou-demo.sdkwork.cn,https://dezhou-demo.birdcoder.cn,http://dezhou-demo.birdcoder.cn,https://dezhou-demo.dtupay.cn,http://dezhou-demo.dtupay.cn,https://dezhou-demo.noaper.cn,http://dezhou-demo.noaper.cn,https://dezhou-demo.skubc.com,http://dezhou-demo.skubc.com,https://dezhou-demo.skubc.cn,http://dezhou-demo.skubc.cn,https://dezhou-demo.zowalk.com,http://dezhou-demo.zowalk.com,https://dezhou-demo.zowalk.cn,http://dezhou-demo.zowalk.cn,https://dezhou-demo.offer86.com,http://dezhou-demo.offer86.com,https://dezhou-demo.offer86.cn,http://dezhou-demo.offer86.cn,https://dezhou-demo.86offer.com,http://dezhou-demo.86offer.com,https://dezhou-demo.86offer.cn,http://dezhou-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
